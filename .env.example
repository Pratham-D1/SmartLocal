# ========================================================
# SmartLocal SMTP Email Configuration (Example / Placeholders)
# ========================================================
# Copy this file or set these environment variables in your system:
# On Windows PowerShell:
#   $env:MAIL_HOST="smtp.gmail.com"
#   $env:MAIL_PORT="587"
#   $env:MAIL_USERNAME="your-email@gmail.com"
#   $env:MAIL_PASSWORD="your-16-char-app-password"
#   $env:MAIL_FROM="your-email@gmail.com"

# SMTP Server host (e.g. smtp.gmail.com, smtp-mail.outlook.com, email-smtp.us-east-1.amazonaws.com)
MAIL_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS or 465 for SSL)
MAIL_PORT=587

# Your SMTP sender email username
MAIL_USERNAME=your-email@gmail.com

# Your SMTP sender password or App Password (never use your regular account password)
# For Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_PASSWORD=your-app-password-here

# Sender address shown in the "From" header
MAIL_FROM=your-email@gmail.com

